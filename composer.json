{
  "name": "coding-libs/laravel-mfa",
  "description": "Laravel Multi-Factor Authentication package (Email, SMS, Google Authenticator TOTP)",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "CodingLibs",
      "email": "codinglibs4u@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "illuminate/database": "^11.0 || ^12.0 || ^13.0",
    "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
    "illuminate/config": "^11.0 || ^12.0 || ^13.0",
    "illuminate/console": "^11.0 || ^12.0 || ^13.0",
    "bacon/bacon-qr-code": "^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "CodingLibs\\MFA\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodingLibs\\MFA\\Tests\\": "tests/",
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CodingLibs\\MFA\\MFAServiceProvider"
      ],
      "aliases": {
        "MFA": "CodingLibs\\MFA\\Facades\\MFA"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "pestphp/pest": "^4.0",
    "orchestra/testbench": "^11.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
